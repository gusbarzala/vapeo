<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121016">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="■ PREVENCIÓN VAPEO"
            android:textColor="#E74C3C"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPuntajeVapeo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="■ SALUD: 0 / 100 PTS"
            android:textColor="#F5F5F0"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlertaVapeo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="#3B1818"
            android:padding="12dp"
            android:text="■ TOCÁ [JUGAR] PARA INICIAR"
            android:textColor="#F5F5F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnJugarVapeo"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#F1C40F"
            android:text="▶ JUGAR"
            android:textColor="#121016"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVapeoAgua"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#E74C3C"
            android:text="▲ 1. VAPEO DE AGUA"
            android:textColor="#F5F5F0"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMarihuana"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#E74C3C"
            android:text="▲ 2. MARIHUANA"
            android:textColor="#F5F5F0"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCigarrillos"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#E74C3C"
            android:text="▲ 3. FUMADOR COMO CIGARRILLOS"
            android:textColor="#F5F5F0"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAntifumador"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#2ECC71"
            android:text="★ 4. ANTIFUMADOR (+35 PTS)"
            android:textColor="#121016"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVolverVapeo"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:backgroundTint="#F5F5F0"
            android:text="■ VOLVER"
            android:textColor="#121016"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>